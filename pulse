#!/bin/bash
# pulse - shortcut to run ContextPulse from anywhere
# This script activates the venv and runs main.py with any arguments you pass

# The directory where ContextPulse lives
PULSE_DIR="$HOME/context-pulse"

# Activate the virtual environment and run
source "$PULSE_DIR/venv/bin/activate"
python "$PULSE_DIR/main.py" "$@"
